{
  "name": "atelier-management-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "lint": "biome check",
    "format": "biome format --write",
    "build": "next build",
    "check": "biome check .",
    "check:unsafe": "biome check --write --unsafe .",
    "check:write": "biome check --write .",
    "db:start": "docker-compose up -d",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:drop": "drizzle-kit drop",
    "dev": "next dev",
    "inngest": "npx inngest-cli@latest dev",
    "seed": "tsx src/drizzle/seed/cli.ts",
    "smoke:dashboard": "tsx scripts/smoke-dashboard.ts",
    "seed:all": "tsx src/drizzle/seed/cli.ts all",
    "seed:clear": "tsx src/drizzle/seed/cli.ts clear",
    "migrate:legacy": "tsx scripts/migrations/migrate-legacy.ts",
    "migrate:legacy:dry": "tsx scripts/migrations/migrate-legacy.ts -- --dry-run",
    "preview": "next build && next start",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.7",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-form": "^1.29.0",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-table": "^8.21.3",
    "@trpc/client": "^11.16.0",
    "@trpc/server": "^11.16.0",
    "@trpc/tanstack-react-query": "^11.16.0",
    "@upstash/redis": "^1.37.0",
    "class-variance-authority": "^0.7.1",
    "client-only": "^0.0.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "firebase-admin": "^14.0.0",
    "inngest": "^4.2.4",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.8.0",
    "next": "16.2.4",
    "next-cloudinary": "^6.17.5",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.5",
    "postgres": "^3.4.9",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.4",
    "react-phone-number-input": "^3.4.16",
    "react-to-print": "^3.1.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.3.0",
    "sonner": "^2.0.7",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.19.4",
    "typescript": "^5"
  }
}
